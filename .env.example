# OpenAI-compatible endpoint used by `agentguard run` / `make eval-ollama` (defaults shown).
AGENTGUARD_BASE_URL=http://localhost:11434/v1
AGENTGUARD_MODEL=llama3.1:8b
AGENTGUARD_API_KEY=ollama
# Optional HMAC key for the audit chain. Keep it where the agent process cannot read it.
AGENTGUARD_AUDIT_KEY=
